#!/usr/bin/env bash
# Launch dev session: window 1 = claude (large) + vscode server + terminal
#                     window 2 = two side-by-side terminals
SESSION="dev"

# Re-attach if session already running
if tmux has-session -t "$SESSION" 2>/dev/null; then
  tmux attach-session -t "$SESSION"
  exit 0
fi

# ── Window 1: dev ────────────────────────────────────────────────────────────
tmux new-session -d -s "$SESSION" -n "dev"

# Right column gets 35%; left (claude) keeps 65%
tmux split-window -h -t "$SESSION:dev" -p 35

# Split right column: top = vscode server, bottom = terminal
tmux split-window -v -t "$SESSION:dev.1"

# Pane 0 (left, large): claude
tmux send-keys -t "$SESSION:dev.0" "claude" Enter

# Pane 1 (top right): code-server (connect via browser at http://localhost:8080)
tmux send-keys -t "$SESSION:dev.1" "code-server" Enter

# Pane 2 (bottom right): regular terminal — left empty

# ── Window 2: terminals ───────────────────────────────────────────────────────
tmux new-window -t "$SESSION" -n "terms"
tmux split-window -h -t "$SESSION:terms"

# Focus window 1, claude pane
tmux select-window -t "$SESSION:dev"
tmux select-pane -t "$SESSION:dev.0"

tmux attach-session -t "$SESSION"
