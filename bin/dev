#!/usr/bin/env bash
# Launch dev session: window 1 = claude (large) + code-server + terminal
#                     window 2 = two side-by-side terminals
#
# Pane targets use tmux's stable pane IDs (%0, %1, ...) captured at creation,
# so this works regardless of base-index / pane-base-index settings.
set -euo pipefail
SESSION="dev"

# Re-attach if session already running
if tmux has-session -t "$SESSION" 2>/dev/null; then
  exec tmux attach-session -t "$SESSION"
fi

# ── Window 1: dev ────────────────────────────────────────────────────────────
tmux new-session -d -s "$SESSION" -n "dev"

# The session starts with one pane (left, large). Grab its id.
left=$(tmux display-message -p -t "$SESSION:dev" '#{pane_id}')

# Right column gets 35%; left (claude) keeps 65%. Capture the new pane's id.
rtop=$(tmux split-window -h -p 35 -t "$left" -P -F '#{pane_id}')

# Split the right column: top = code-server, bottom = terminal.
rbot=$(tmux split-window -v -t "$rtop" -P -F '#{pane_id}')

# Left (large): claude
tmux send-keys -t "$left" "claude" Enter

# Top right: code-server (connect via browser at http://localhost:8080)
tmux send-keys -t "$rtop" "code-server" Enter

# Bottom right ($rbot): regular terminal — left empty

# ── Window 2: terminals ───────────────────────────────────────────────────────
# -a (insert after) so this works when `dev` is run from inside an existing
# tmux session; a plain `new-window -t dev` targets the session's current
# window index (1) and fails with "index 1 in use".
tmux new-window -a -t "$SESSION" -n "terms"
tmux split-window -h -t "$SESSION:terms"

# Focus window 1, claude pane
tmux select-window -t "$SESSION:dev"
tmux select-pane -t "$left"

exec tmux attach-session -t "$SESSION"
